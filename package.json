{
  "name": "poe2-craft-planner",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "PoE 2 Craft Planner — web service for Path of Exile 2 crafting analysis",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "dev": "pnpm --filter @poe2-craft/web dev",
    "build": "pnpm data:art && pnpm --filter @poe2-craft/web build",
    "start": "pnpm --filter @poe2-craft/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "data:fetch": "node scripts/data/fetch.ts",
    "data:fetch:pinned": "node scripts/data/fetch.ts --pinned",
    "data:normalize": "node scripts/data/normalize.ts",
    "data:validate": "vitest run packages/craft-db/src/production/production.test.ts",
    "data:golden": "node scripts/data/golden.ts",
    "data:prices": "node scripts/data/prices.ts",
    "data:art": "node scripts/data/art.ts",
    "data:report": "node scripts/data/report.ts",
    "data:weights:fetch": "node scripts/data/weights-fetch.ts",
    "data:weights:normalize": "node scripts/data/weights-normalize.ts",
    "data:weights:validate": "vitest run tests/weights-pipeline.test.ts packages/craft-db/src/production/production.test.ts packages/craft-session/src/golden.test.ts",
    "data:weights:report": "node scripts/data/report.ts --weights",
    "data:weights": "pnpm data:weights:fetch && pnpm data:weights:normalize && pnpm data:weights:validate && pnpm data:weights:report",
    "data:refresh": "pnpm data:fetch && pnpm data:normalize && pnpm data:weights:fetch && pnpm data:weights:normalize && pnpm data:validate && pnpm data:weights:validate && pnpm data:report"
  },
  "devDependencies": {
    "@poe2-craft/craft-db": "workspace:*",
    "@types/node": "^26.6.3",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
